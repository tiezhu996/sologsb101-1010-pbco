{
  "name": "gblightprot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "防雷装置检测与接地电阻台账 - 纯前端 SPA（Svelte 5 + TypeScript + Vite + Svelte SPA Router + Tailwind CSS + Dexie）",
